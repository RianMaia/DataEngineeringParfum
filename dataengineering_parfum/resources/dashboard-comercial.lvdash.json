{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas comerciais",
      "queryLines": [
        "WITH vendas AS (\n",
        "  SELECT item_id, pedido_id, data_pedido, ano, mes, canal, cliente_id, razao_social,\n",
        "         segmento, cidade, marca, categoria, receita, margem,\n",
        "         SUM(receita) OVER (PARTITION BY cliente_id) AS receita_cliente\n",
        "  FROM fato_vendas\n",
        "),\n",
        "vendas_ranqueadas AS (\n",
        "  SELECT item_id, pedido_id, data_pedido, ano, mes, canal, cliente_id, razao_social,\n",
        "         segmento, cidade, marca, categoria, receita, margem,\n",
        "         DENSE_RANK() OVER (ORDER BY receita_cliente DESC) AS ranking_cliente\n",
        "  FROM vendas\n",
        ")\n",
        "SELECT item_id, pedido_id, data_pedido, ano, mes, canal, cliente_id, razao_social,\n",
        "       segmento, cidade, marca, categoria, receita, margem, ranking_cliente\n",
        "FROM vendas_ranqueadas "
      ],
      "columns": [
        {
          "displayName": "Receita",
          "description": "Receita líquida de vendas, incluindo devoluções",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Margem",
          "description": "Receita menos custo dos produtos",
          "expression": "SUM(`margem`)"
        },
        {
          "displayName": "Pedidos",
          "description": "Quantidade distinta de pedidos não cancelados",
          "expression": "COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Ticket Médio",
          "description": "Receita líquida dividida pela quantidade de pedidos",
          "expression": "SUM(`receita`) / NULLIF(COUNT(DISTINCT `pedido_id`), 0)"
        },
        {
          "displayName": "Margem Percentual",
          "description": "Margem dividida pela receita líquida",
          "expression": "SUM(`margem`) / NULLIF(SUM(`receita`), 0)"
        }
      ]
    },
    {
      "name": "ds_fila",
      "displayName": "Fila comercial da semana",
      "queryLines": [
        "SELECT vendedor, ordem, cliente_id, razao_social, cidade, uf, score, faixa, ticket_medio, motivo, sugestao\n",
        "FROM fila_semanal\n",
        "ORDER BY vendedor, ordem"
      ]
    }
  ],
