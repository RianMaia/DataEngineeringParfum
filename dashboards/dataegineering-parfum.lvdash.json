{
  "datasets": [
    {
      "name": "fato_vendas",
      "displayName": "Fato Vendas",
      "config": {
        "version": "1.1",
        "source": "lakehouse_rotaperfume.gold.fato_vendas",
        "dimensions": [
          {
            "name": "data_pedido",
            "expr": "data_pedido",
            "displayName": "Data do Pedido"
          },
          {
            "name": "ano_pedido",
            "expr": "YEAR(data_pedido)",
            "displayName": "Ano"
          },
          {
            "name": "mes_pedido",
            "expr": "DATE_TRUNC('MONTH', data_pedido)",
            "displayName": "Mês do Pedido"
          },
          {
            "name": "segmento",
            "expr": "segmento",
            "displayName": "Segmento"
          },
          {
            "name": "cidade",
            "expr": "cidade",
            "displayName": "Cidade"
          },
          {
            "name": "marca",
            "expr": "marca",
            "displayName": "Marca"
          },
          {
            "name": "categoria",
            "expr": "categoria",
            "displayName": "Categoria"
          },
          {
            "name": "canal",
            "expr": "canal",
            "displayName": "Canal"
          },
          {
            "name": "razao_social",
            "expr": "razao_social",
            "displayName": "Razão Social"
          },
          {
            "name": "pedido_id",
            "expr": "pedido_id",
            "displayName": "ID do Pedido"
          }
        ],
        "measures": [
          {
            "name": "receita_total",
            "expr": "SUM(receita)",
            "displayName": "Receita Total",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "margem_total",
            "expr": "SUM(margem)",
            "displayName": "Margem Total",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "num_pedidos",
            "expr": "COUNT(DISTINCT pedido_id)",
            "displayName": "Número de Pedidos"
          },
          {
            "name": "ticket_medio",
            "expr": "SUM(receita) / COUNT(DISTINCT pedido_id)",
            "displayName": "Ticket Médio",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "margem_percentual",
            "expr": "100 * SUM(margem) / NULLIF(SUM(receita), 0)",
            "displayName": "Margem Percentual",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "fila_semanal",
      "displayName": "Fila Semanal",
      "config": {
        "version": "1.1",
        "source": "lakehouse_rotaperfume.gold.fila_semanal",
        "dimensions": [
          {
            "name": "ordem",
            "expr": "ordem",
            "displayName": "Ordem"
          },
          {
            "name": "vendedor",
            "expr": "vendedor",
            "displayName": "Vendedor"
          },
          {
            "name": "cliente_id",
            "expr": "cliente_id",
            "displayName": "ID do Cliente"
          },
          {
            "name": "razao_social",
            "expr": "razao_social",
            "displayName": "Razão Social"
          },
          {
            "name": "cidade",
            "expr": "cidade",
            "displayName": "Cidade"
          },
          {
            "name": "uf",
            "expr": "uf",
            "displayName": "UF"
          },
          {
            "name": "score",
            "expr": "score",
            "displayName": "Score",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 4.0
              }
            }
          },
          {
            "name": "faixa",
            "expr": "faixa",
            "displayName": "Faixa"
          },
          {
            "name": "ticket_medio",
            "expr": "ticket_medio",
            "displayName": "Ticket Médio",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "motivo",
            "expr": "motivo",
            "displayName": "Motivo"
          },
          {
            "name": "sugestao",
            "expr": "sugestao",
            "displayName": "Sugestão"
          }
        ],
        "measures": [
          {
            "name": "total_contatos",
            "expr": "COUNT(*)",
            "displayName": "Total de Contatos"
          },
          {
            "name": "vendedores_distintos",
            "expr": "COUNT(DISTINCT vendedor)",
            "displayName": "Vendedores Distintos"
          },
          {
            "name": "score_medio",
            "expr": "AVG(score)",
            "displayName": "Score Médio",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 4.0
              }
            }
          },
          {
            "name": "muito_quente_count",
            "expr": "COUNT(*) FILTER (WHERE faixa = 'Muito quente')",
            "displayName": "Clientes Muito Quente"
          }
        ]
      }
    },
    {
      "name": "top_20_clientes",
      "displayName": "Top 20 Clientes por Receita",
      "queryLines": [
        "WITH top_clientes AS (\n",
        "  SELECT\n",
        "    razao_social,\n",
        "    SUM(receita) as receita_total\n",
        "  FROM\n",
        "    lakehouse_rotaperfume.gold.fato_vendas\n",
        "  GROUP BY\n",
        "    razao_social\n",
        "  ORDER BY\n",
        "    receita_total DESC\n",
        "  LIMIT 20\n",
        ")\n",
        "SELECT\n",
        "  razao_social,\n",
        "  receita_total\n",
        "FROM\n",
        "  top_clientes\n",
        "ORDER BY\n",
        "  receita_total DESC"
      ]
    }
  ],
